{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evalguard.dev/schemas/evalguard.schema.json",
  "title": "EvalGuard project config",
  "type": "object",
  "required": ["version", "project", "providers", "datasets"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "template": {
      "type": "string",
      "enum": ["text_gen", "rag", "text_to_sql", "custom"],
      "default": "text_gen"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "config": { "type": "object" }
        }
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "template": { "type": "string" }
        },
        "oneOf": [
          { "required": ["file"] },
          { "required": ["template"] }
        ]
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "file"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "heuristics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "judges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "rules"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "blocking": { "type": "boolean", "default": true },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["metric", "op", "value"],
              "additionalProperties": false,
              "properties": {
                "metric": { "type": "string" },
                "op": { "type": "string", "enum": [">=", "<=", ">", "<", "==", "!="] },
                "value": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": { "type": "string", "default": ".evalguard/cache" },
        "enabled": { "type": "boolean", "default": true }
      }
    },
    "concurrency": { "type": "integer", "minimum": 1, "default": 8 },
    "cost_cap_usd": { "type": "number", "minimum": 0 }
  }
}
