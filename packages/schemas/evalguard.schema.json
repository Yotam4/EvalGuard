{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evalguard.dev/schemas/evalguard.schema.json",
  "title": "EvalGuard project config",
  "type": "object",
  "required": ["version", "project", "providers", "datasets"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "template": {
      "type": "string",
      "enum": ["text_gen", "rag", "text_to_sql", "custom"],
      "default": "text_gen"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "config": { "type": "object" }
        }
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "template": { "type": "string" }
        },
        "oneOf": [
          { "required": ["file"] },
          { "required": ["template"] }
        ]
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "file"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "heuristics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "judges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "gates": {
      "type": "array",
      "description": "Legacy global gates. Per-layer gates under top-level 'layers' supersede this; both shapes are accepted simultaneously.",
      "items": {
        "type": "object",
        "required": ["name", "rules"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "blocking": { "type": "boolean", "default": true },
          "severity": { "type": "string", "enum": ["block", "warn", "log"] },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/rule" }
          }
        }
      }
    },
    "run_mode": {
      "type": "string",
      "enum": ["always", "short_circuit", "short_circuit_blocking_only"],
      "default": "short_circuit_blocking_only",
      "description": "Layer-interaction policy. 'always' runs every layer; 'short_circuit' aborts on any layer fail; 'short_circuit_blocking_only' (default) skips later layers only when an upstream block-severity gate fails."
    },
    "layers": {
      "type": "object",
      "description": "Per-layer gates. Keys are stable layer names: heuristics, metrics, judge_offline, judge_online, human.",
      "additionalProperties": false,
      "properties": {
        "heuristics":     { "$ref": "#/$defs/layerGate" },
        "metrics":        { "$ref": "#/$defs/layerGate" },
        "judge_offline":  { "$ref": "#/$defs/layerGate" },
        "judge_online":   { "$ref": "#/$defs/layerGate" },
        "human":          { "$ref": "#/$defs/layerGate" }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir":     { "type": "string", "default": ".evalguard/cache" },
        "enabled": { "type": "boolean", "default": true }
      }
    },
    "concurrency": { "type": "integer", "minimum": 1, "default": 8 },
    "cost_cap_usd": { "type": "number", "minimum": 0 },
    "gate_strategy": {
      "type": "string",
      "enum": ["all", "any"],
      "default": "all",
      "description": "How to combine per-trial gate verdicts. 'all' (default) requires every trial to pass all blocking gates; 'any' passes the run if at least one trial passes."
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-run audit / governance controls. Events are always recorded; this block configures retention and privacy.",
      "properties": {
        "redact_payload": {
          "type": "boolean",
          "default": false,
          "description": "When true, strip rendered prompts / raw responses / judge reasons from event payloads but keep their content hashes so the chain still verifies."
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["metric", "op", "value"],
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string" },
        "op":     { "type": "string", "enum": [">=", "<=", ">", "<", "==", "!="] },
        "value":  { "type": "number" }
      }
    },
    "layerGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity"],
      "properties": {
        "severity":   { "type": "string", "enum": ["block", "warn", "log"] },
        "aggregation": {
          "type": "string",
          "enum": ["pass_rate", "row_pass_rate", "mean", "p50", "p95", "count_failures", "pass_rate_by_tag"],
          "default": "pass_rate"
        },
        "evaluator":  {
          "type": "string",
          "description": "Optional: scope this gate to a single evaluator id rather than the layer roll-up."
        },
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type":              { "type": "string", "enum": ["absolute"], "default": "absolute" },
            "min":               { "type": "number" },
            "max":               { "type": "number" },
            "per_tag_overrides": { "type": "object", "additionalProperties": { "type": "number" } }
          }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "custom_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module"],
          "description": "Escape hatch: invoke a Python function as part of this gate. Function signature: (metrics: dict, config: dict) -> {'passed': bool, 'details': list}.",
          "properties": {
            "module": {
              "type": "string",
              "description": "Dotted path with optional ':' separator, e.g. 'my_pkg.gates:safety_check' or 'my_pkg.gates.safety_check'."
            },
            "config": { "type": "object" }
          }
        }
      }
    }
  }
}
